<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base app theme. Compose drives the actual Material3 UI; this XML theme
         only needs to provide a no-action-bar window with the PDFSeal black
         background so there is no white flash before Compose renders. -->
    <style name="Theme.PDFSeal" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/pdfseal_black</item>
        <item name="android:statusBarColor">@color/pdfseal_black</item>
        <item name="android:navigationBarColor">@color/pdfseal_black</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- Launch screen via androidx.core.splashscreen. -->
    <style name="Theme.PDFSeal.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/pdfseal_black</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.PDFSeal</item>
    </style>

</resources>
